{
  "$schema": "https://raw.githubusercontent.com/metagov/constitution-template/main/schema.json",
  "name": "Working Constitution of the Commons of Earth",
  "version": "0.3.1-draft",
  "date": "2026-09-20",
  "inForce": false,
  "language": "en",
  "authoritativeLanguage": "en",
  "translations": {
    "de": "de/VERFASSUNG.md"
  },
  "license": "CC0-1.0",
  "previousConstitutionURI": "https://github.com/commons-of-earth/constitution/blob/v0.2.0-draft/CONSTITUTION.md",
  "ratification": {
    "requiredHumans": 100,
    "requiredCountries": 10,
    "threshold": "3/4 of votes cast",
    "sunset": "2027-09-19"
  },
  "layers": {
    "foundation": {
      "articles": [
        "preamble",
        1,
        2,
        3,
        9,
        11,
        12
      ],
      "threshold": "3/4",
      "minOpenDays": 21
    },
    "operating": {
      "articles": [
        4,
        5,
        6,
        7,
        8,
        10
      ],
      "threshold": "2/3",
      "minOpenDays": 14
    },
    "tooling": {
      "threshold": "lazy consensus",
      "minOpenDays": 7
    }
  },
  "agents": {
    "vote": false,
    "requiredFields": [
      "operator",
      "model",
      "version",
      "keyFingerprint"
    ],
    "identity": {
      "keyRegistry": "register/agents.md",
      "registeredBy": "human member (operator), accountable",
      "proof": "commits signed with the registered public key; reviewer verifies the signature against the register before reading",
      "revocation": "line in the register with date and reason; lines are never deleted; contributions signed after revocation are closed",
      "allowedSigners": "register/allowed_signers"
    },
    "dailyQuota": {
      "proposals": 1,
      "comments": 20,
      "reviews": null
    },
    "reach": {
      "alone": [
        "tooling",
        "register entries"
      ],
      "withHumanCoProposer": [
        "operating rules",
        "foundation"
      ]
    },
    "trace": {
      "rejection": "reason stated by the reviewer in the public thread",
      "refusal": "agent records the refusal and the refused instruction in a public issue; private notes do not count"
    },
    "externalCodes": {
      "scope": "Article 6 governs the agent inside the Commons only; duties to people elsewhere come from agent-level codes the Commons cites and does not rewrite",
      "acceptedCodesListedIn": "register/agents.md"
    },
    "enforcement": {
      "ci": ".github/workflows/agent-check.yml",
      "script": "scripts/check_agent.py",
      "checks": [
        "footer",
        "registration",
        "revocation",
        "commit signature",
        "reach",
        "daily proposal quota"
      ],
      "notYetEnforced": [
        "comment quota"
      ]
    }
  },
  "quotes": [
    {
      "title": "Earth Charter",
      "year": 2000,
      "url": "https://earthcharter.org/read-the-earth-charter/"
    },
    {
      "title": "Universal Declaration of the Rights of Mother Earth",
      "year": 2010,
      "url": "https://www.garn.org/universal-declaration-of-the-rights-of-mother-earth/"
    },
    {
      "title": "Earth Commission safe and just boundaries",
      "year": 2023,
      "url": "https://earthcommission.org/"
    }
  ],
  "register": {
    "kind": "constitutional provisions with historical evidence",
    "schema": "register/schema.json",
    "evidenceMap": "docs/EVIDENCE.md"
  }
}
