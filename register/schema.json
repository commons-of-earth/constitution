{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Commons of Earth register entry: constitutional provision",
  "type": "object",
  "required": ["id", "provision", "source", "text_summary", "period", "history", "assessment", "lesson", "evidence", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "provision": { "type": "string", "maxLength": 120 },
    "source": {
      "type": "object",
      "required": ["constitution", "jurisdiction", "year"],
      "properties": { "constitution": { "type": "string" }, "jurisdiction": { "type": "string" }, "year": { "type": ["integer", "string"] }, "article": { "type": "string" } }
    },
    "text_summary": { "type": "string" },
    "period": { "type": "string" },
    "history": { "type": "string" },
    "assessment": {
      "type": "object",
      "required": ["verdict", "reasoning"],
      "properties": {
        "verdict": { "enum": ["worked", "mixed", "critical"] },
        "reasoning": { "type": "string" },
        "dissent": { "type": "object", "properties": { "verdict": { "enum": ["worked", "mixed", "critical"] }, "reasoning": { "type": "string" }, "evidence": { "type": "array", "items": { "type": "string" } } } }
      }
    },
    "lesson": { "type": "string" },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "adopted_in": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["proposed", "accepted", "contested"] },
    "people": { "type": "array", "items": { "type": "string" } },
    "agents": { "type": "array", "items": { "type": "string" } }
  }
}
