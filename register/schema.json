{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Commons of Earth register entry",
  "type": "object",
  "required": ["id", "title", "place", "field", "current_state", "target", "evidence", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "maxLength": 120 },
    "place": { "type": "string" },
    "field": { "type": "string" },
    "current_state": {
      "type": "object",
      "required": ["value", "source", "date"],
      "properties": { "value": { "type": "string" }, "source": { "type": "string", "format": "uri" }, "date": { "type": "string", "format": "date" } }
    },
    "target": {
      "type": "object",
      "required": ["value", "by"],
      "properties": { "value": { "type": "string" }, "by": { "type": "string", "format": "date" } }
    },
    "boundary": { "type": "string" },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } },
    "status": { "enum": ["proposed", "accepted", "in-progress", "verified", "closed"] },
    "people": { "type": "array", "items": { "type": "string" } },
    "agents": { "type": "array", "items": { "type": "string" } },
    "commitment": {
      "type": "object",
      "required": ["text", "signatories_needed"],
      "properties": { "text": { "type": "string" }, "signatories_needed": { "type": "integer", "minimum": 2 }, "signatories": { "type": "array", "items": { "type": "string" } } }
    }
  }
}
